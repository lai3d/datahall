{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lai3d/datahall/spec/catalog.schema.json",
  "title": "DataHall equipment catalog",
  "description": "Equipment types for the capacity model. Figures are public estimates for teaching; every entry lists the sources behind its figures.",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "units",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Data version: the date the figures were last checked against their sources (the newest `checked` date)"
    },
    "units": {
      "type": "object"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "cables": {
      "type": "array",
      "description": "Cable and optics classes for the back-end fabric, shortest reach first",
      "items": {
        "$ref": "#/$defs/cable"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "name",
        "group",
        "c",
        "cap",
        "h",
        "note",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "name": {
          "type": "string",
          "description": "Chinese source text"
        },
        "group": {
          "enum": [
            "gpu",
            "net",
            "fac"
          ]
        },
        "c": {
          "type": "string",
          "pattern": "^--[a-z]+$"
        },
        "gpus": {
          "type": "integer",
          "minimum": 1
        },
        "kw": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "IT power, kW"
        },
        "liq": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "liqCool": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "airCool": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dist": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ports": {
          "type": "integer",
          "minimum": 1
        },
        "radix": {
          "type": "integer",
          "minimum": 1,
          "description": "Ports per switch (back-end fabric)"
        },
        "portGbps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Speed of one switch port, Gb/s"
        },
        "ovh": {
          "type": "number",
          "minimum": 0
        },
        "cap": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated price, million USD"
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "future": {
          "type": "boolean"
        },
        "airDense": {
          "type": "boolean",
          "description": "Air-cooled rack dense enough that real deployments need rear-door heat exchangers; the capacity check warns about it"
        },
        "fabric": {
          "enum": [
            "x800",
            "quantum2",
            "ethernet",
            "unsourced"
          ],
          "description": "Back-end (scale-out) fabric: x800 = modeled on Quantum-X800 InfiniBand; the others say why it is not modeled"
        },
        "nics": {
          "type": "integer",
          "minimum": 1,
          "description": "Back-end NIC ports per rack (scale-out endpoints), across all planes"
        },
        "rails": {
          "type": "integer",
          "minimum": 1,
          "description": "Rails across all planes: NIC positions within a compute tray"
        },
        "planes": {
          "type": "integer",
          "minimum": 1,
          "description": "Independent fabrics the NICs are split over; 1 when omitted"
        },
        "nicGbps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Speed of one back-end NIC port, Gb/s"
        },
        "note": {
          "type": "string",
          "description": "Chinese source text"
        },
        "i18n": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "ranges": {
          "type": "object",
          "description": "Range the sources give for a figure, when they give one; the simulation value must fall inside it",
          "propertyNames": {
            "$ref": "#/$defs/field"
          },
          "additionalProperties": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": false
    },
    "field": {
      "enum": [
        "kw",
        "gpus",
        "liq",
        "liqCool",
        "airCool",
        "dist",
        "ports",
        "ovh",
        "cap",
        "radix",
        "portGbps",
        "fabric",
        "nics",
        "rails",
        "planes",
        "nicGbps",
        "maxM"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "type",
        "checked",
        "supports"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$",
          "description": "Publication or last-updated date as shown by the source; omitted for undated product pages"
        },
        "checked": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "When the source was last checked against the catalog value"
        },
        "type": {
          "enum": [
            "official",
            "reported",
            "estimate"
          ],
          "description": "official: the vendor's own material; reported: journalists or analysts; estimate: this project's own reasoning"
        },
        "supports": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/field"
          },
          "description": "Catalog fields this source backs; empty for context-only sources"
        },
        "i18n": {
          "type": "object",
          "description": "Translations of this source title; publication titles are never translated, only this project’s own estimate notes",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "type": {
            "not": {
              "const": "estimate"
            }
          }
        }
      },
      "then": {
        "required": [
          "url",
          "publisher"
        ]
      },
      "additionalProperties": false
    },
    "cable": {
      "type": "object",
      "required": [
        "id",
        "gbps",
        "ends",
        "maxM",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "gbps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Port speed the class is for, Gb/s"
        },
        "ends": {
          "enum": [
            "nic",
            "switch",
            "any"
          ],
          "description": "nic: switch to NIC runs only; switch: switch to switch only; any: both"
        },
        "maxM": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Longest run, m"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  }
}
