{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lai3d/datahall/spec/layout.schema.json",
  "title": "GPU Data Hall layout",
  "description": "Hall layout exchanged with the Unity app. Produced by the web page (web/src/layout-export.js) and by tools/usd_to_unity.py from a .usda file. Units: kW, m, million USD.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "generator", "generated", "grid", "utilityMw", "catalog", "equipment"],
  "properties": {
    "format": {"const": "dchall.layout"},
    "version": {"const": 1},
    "generator": {"type": "string"},
    "generated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows", "cellWidthM", "cellDepthM"],
      "properties": {
        "columns": {"type": "integer", "minimum": 1},
        "rows": {"type": "integer", "minimum": 1},
        "cellWidthM": {"type": "number", "exclusiveMinimum": 0},
        "cellDepthM": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "utilityMw": {"type": "number", "exclusiveMinimum": 0},
    "catalog": {
      "description": "Parameters in effect for each equipment type used in the hall, in first-use order.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "powerKw", "gpuCount", "liquidFraction", "liquidCoolingKw", "airCoolingKw", "overheadKw", "distributionKw", "fabricPorts", "capexMusd", "roadmap", "heightM"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z_]\\w*$"},
          "name": {"type": "string"},
          "category": {"enum": ["gpu", "net", "fac"]},
          "powerKw": {"type": "number", "minimum": 0},
          "gpuCount": {"type": "integer", "minimum": 0},
          "liquidFraction": {"type": "number", "minimum": 0, "maximum": 1},
          "liquidCoolingKw": {"type": "number", "minimum": 0},
          "airCoolingKw": {"type": "number", "minimum": 0},
          "overheadKw": {"type": "number", "minimum": 0},
          "distributionKw": {"type": "number", "minimum": 0},
          "fabricPorts": {"type": "integer", "minimum": 0},
          "capexMusd": {"type": "number", "minimum": 0},
          "roadmap": {"type": "boolean"},
          "heightM": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "equipment": {
      "description": "Placed equipment in file order. Position is the grid cell; see docs/unity-options.md for the Unity coordinate mapping.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "column", "row", "powerFeed", "coolantSource"],
        "properties": {
          "name": {"type": "string", "pattern": "^R\\d{2}_C\\d{2}$"},
          "type": {"type": "string"},
          "column": {"type": "integer", "minimum": 0},
          "row": {"type": "integer", "minimum": 0},
          "powerFeed": {"description": "Name of the RPP feeding this equipment, or empty.", "type": "string", "pattern": "^(R\\d{2}_C\\d{2})?$"},
          "coolantSource": {"description": "Name of the CDU supplying coolant, or empty.", "type": "string", "pattern": "^(R\\d{2}_C\\d{2})?$"}
        }
      }
    }
  }
}
